## Multi-stage lightweight image for quantumai-usdt-apps service
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	PIP_NO_CACHE_DIR=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirement spec (constraints optional)
COPY requirements.txt ./requirements.txt

# Copy constraints.txt only if it exists in build context (ignored if absent)
ADD constraints.txt ./constraints.txt

# Install dependencies (fallback if constraints missing or empty)
RUN pip install --upgrade pip && \
	if [ -s constraints.txt ]; then \
		pip install -c constraints.txt -r requirements.txt gunicorn; \
	else \
		pip install -r requirements.txt gunicorn; \
	fi

COPY . /app

EXPOSE 5002

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=15s \
    CMD curl -fsS http://127.0.0.1:5002/health || exit 1

CMD ["gunicorn", "-b", "0.0.0.0:5002", "-w", "2", "-k", "gthread", "--threads", "4", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
